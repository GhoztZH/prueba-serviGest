# Copie este archivo como `.env` y reemplace los valores. `.env` NO se versiona.

# --- PostgreSQL ---
POSTGRES_DB=servigest
POSTGRES_USER=servigest
# Use solo letras y números (el valor se inserta en una URL de conexión).
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_PORT=5433

# --- Backend ---
# Secreto de firma de los JWT: mínimo 32 caracteres aleatorios.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplace-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_MIN=480
# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:8080
APP_TIMEZONE=America/Guayaquil
HORAS_EXPIRACION_RESET=1
LOGIN_RATE_MAX=10

# Administrador inicial: se crea solo si aún no existe ningún ADMIN.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# true = carga los datos de DEMOSTRACIÓN una sola vez (usuarios de prueba del contrato OpenAPI).
SEED_DEMO=true

# --- Puertos publicados en el host ---
FRONTEND_PORT=8080
BACKEND_PORT=3000

# --- Solo desarrollo local (npm run dev / pruebas), fuera de Docker ---
DATABASE_URL=postgres://servigest:cambie-esta-clave@localhost:5433/servigest
TEST_DATABASE_URL=postgres://servigest:cambie-esta-clave@localhost:5433/servigest_test
